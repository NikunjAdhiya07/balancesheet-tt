# Copy this file to .env.local and fill in the values below.
# Local dev needs these too — the app now talks to Supabase instead of a local SQLite file.

# --- Supabase (database + storage) ---
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# Before running locally or deploying:
# 1. Run supabase/schema.sql once in the Supabase SQL Editor to create the tables
#    (the app talks to Postgres through Supabase's REST client, which can't run DDL).
# 2. Create a PUBLIC bucket named "attachments" in Supabase Storage
#    (Storage tab -> New bucket -> toggle Public) for income/expense receipt uploads.
